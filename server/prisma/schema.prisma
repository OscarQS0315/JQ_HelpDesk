// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//Models
enum E_AssignedMethod {
  AUTOMATIC
  MANUAL
}
enum E_Role {
  ADMIN
  USER
  TECHNICIAN
}
enum E_TechnicianStatus {
  AVAILABLE
  BUSY
}
enum E_TicketStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}
enum E_TicketPriority {
  LOW
  MEDIUM
  HIGH
}
model User {
  id                          Int                         @id @default(autoincrement())
  name                        String
  lastName                    String
  email                       String                      @unique
  password                    String
  profileImage                String?
  role                        E_Role                      @default(USER)
  status                      Boolean                     @default(true)
  lastLogin                   DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  // Relations
  userTechnician              UserTechnician?
  tickets                     Ticket[]
  ticketHistory               TicketHistory[]
  notifications               Notification[]
}

model UserTechnician {
  id                          Int                         @id @default(autoincrement())
  userId                      Int                         @unique
  status                      E_TechnicianStatus          @default(AVAILABLE)
  workload                    Int                         @default(0) //carga de trabajo
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  // Relations
  user                        User                        @relation(fields: [userId], references: [id])
  specialities                SpecialityArea[]
  tickets                     Ticket[]
}

model SpecialityArea {
  id                          Int                         @id @default(autoincrement())
  name                        String                      @unique
  description                 String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  // Relations
  technicians                 UserTechnician[]
  ticketCategories            TicketCategory[]
}
model CategoryEtiquette {
  id                          Int                         @id @default(autoincrement())
  name                        String                      @unique
  description                 String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  // Relations
  ticketCategories            TicketCategory[]
}
model SLA{
  id                          Int                         @id @default(autoincrement())
  name                        String                      @unique
  description                 String?
  slaReplyHours               Int
  slaResolutionHours          Int
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  // Relations
  TicketCategory              TicketCategory[]
}
model TicketCategory {
  id                          Int                         @id @default(autoincrement())
  name                        String                      @unique
  description                 String?
  slaId                       Int
  imageUrl                    String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  // Relations
  SLA                         SLA                         @relation(fields: [slaId], references: [id])
  specialities                SpecialityArea[]
  categoryEtiquettes          CategoryEtiquette[]
  tickets                     Ticket[]
}
model AutoTriageRule{
  id                          Int                         @id @default(autoincrement())
  timeRemainingSLA            Int
  ticketPriority              E_TicketPriority
  technicianSpecialityId      Int
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  // Relations
  Ticket Ticket[]
}
model Ticket {
  id                          Int                        @id @default(autoincrement())
  userId                      Int
  technicianId                Int?
  ticketCategoryId            Int
  title                       String
  description                 String?
  status                      E_TicketStatus              @default(PENDING) // PENDING, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  priority                    E_TicketPriority            @default(MEDIUM) // LOW, MEDIUM, HIGH
  storyPoints                 Int?
  aceptanceCriteria           String?
  comments                    String?
  resolutionDays              Int?
  slaReply                    DateTime?                    @default(now())
  slaResolution               DateTime?                    @default(now())
  replyAchieved               Boolean?                     @default(false)
  resolutionAchieved          Boolean?                     @default(false)
  ticketValorationId          Int?
  closedAt                    DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  assignedAt                  DateTime?
  assignedMethod              E_AssignedMethod?
  automaticTriageRuleId      Int?
  // Relations
  user                        User                        @relation(fields: [userId], references: [id])
  technician                  UserTechnician?             @relation(fields: [technicianId], references: [id])
  ticketImages                TicketImage[]
  ticketHistory               TicketHistory[]
  ticketCategory              TicketCategory              @relation(fields: [ticketCategoryId], references: [id])
  notifications               Notification[]
  ticketValoration            TicketValoration?
  automaticTriageRule         AutoTriageRule?             @relation(fields: [automaticTriageRuleId], references: [id])
}

model TicketImage{
  id                          Int                         @id @default(autoincrement())
  ticketId                    Int?
  ticketHistoryId  Int?
  imageUrl                    String
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  // Relations
  ticket                      Ticket?                     @relation(fields: [ticketId], references: [id])
  ticketHistory               TicketHistory?              @relation(fields: [ticketHistoryId], references: [id])
}

model TicketHistory {
  id            Int             @id @default(autoincrement())
  ticketId      Int
  status        E_TicketStatus
  changedBy     Int
  changedAt     DateTime        @default(now())
  observation   String          

  ticket        Ticket          @relation(fields: [ticketId], references: [id])
  user          User            @relation(fields: [changedBy], references: [id])
  ticketImages  TicketImage[]
}




model Notification {
  id                          Int                         @id @default(autoincrement())
  userId                      Int
  message                     String
  isRead                      Boolean                     @default(false)
  ticketId                    Int?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  // Relations
  user                        User                        @relation(fields: [userId], references: [id])
  ticket                      Ticket?                     @relation(fields: [ticketId], references: [id])
}

model TicketValoration {
  id                          Int                         @id @default(autoincrement())
  ticketId                    Int                         @unique
  rating                      Int                         
  comments                    String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  // Relations
  ticket                      Ticket                      @relation(fields: [ticketId], references: [id])
}